{
  "schemaVersion": 1,
  "id": "straytracker",
  "version": "${version}",
  "name": "StrayTracker",
  "description": "Tracks guild online counts via /guild online: auto-polls on a timer, records peak online counts per guild, shows a HUD overlay and a peak-overview on hotkey. Configurable via ModMenu.",
  "authors": ["StrayTracker"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/straytracker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.straytracker.StrayTrackerClient"
    ],
    "modmenu": [
      "com.straytracker.StrayTrackerMenuIntegration"
    ]
  },
  "mixins": [
    "straytracker.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": ">=1.21.11 <=26.1.2",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu:badges": ["library"]
  }
}
