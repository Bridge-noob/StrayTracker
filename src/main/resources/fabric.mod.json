{
  "schemaVersion": 1,
  "id": "StrayTracker",
  "version": "${version}",
  "name": "Guild Mod",
  "description": "Tracks guild online members with /guild online, hotkey peak tracking, HUD overlay and ModMenu config.",
  "authors": ["StrayTracker"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/StrayTracker/textures/guild/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.straytracker.StrayTracker.StrayTrackerClient"
    ],
    "modmenu": [
      "com.straytracker.StrayTracker.StrayTrackerMenuIntegration"
    ]
  },
  "mixins": [
    "StrayTracker.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": ">=0.119.6",
    "minecraft": ">=1.21.11 <=26.1.2",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  },
  "breaks": {},
  "custom": {
    "modmenu:badges": [
      "library"
    ]
  }
}
